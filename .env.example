MONGOMS_MD5_CHECK=false
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hand_holding_mini?retryWrites=true&w=majority
# Note: URL-encode special characters in username/password (e.g., @ -> %40, : -> %3A)
JWT_SECRET=hand-holding-dev-secret
PORT=5000
NODE_ENV=development
# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Backend origin used by the frontend in production (no /api suffix is added by this value)
# Override with: VITE_API_URL=https://your-render-service.onrender.com
VITE_API_URL=http://localhost:5000